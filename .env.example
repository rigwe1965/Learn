# Neon Postgres connection string (https://console.neon.tech)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Better Auth
# Generate a secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (https://resend.com). Without a key, dev prints links to the server log.
# The default sender can only email your own Resend account; verify a domain
# and set EMAIL_FROM to send to anyone.
RESEND_API_KEY=""
EMAIL_FROM="Atelier Nord <onboarding@resend.dev>"

# Stripe (https://dashboard.stripe.com/test/apikeys). Use test keys locally.
# Webhook secret: run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# (optional locally: the success page also records the order).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
